# Copiar como .env y completar. Nunca subir el .env a GitHub.

# Clave del panel web (usuario: cualquiera, p. ej. admin). CAMBIARLA en producción.
TAXIFF_CLAVE_PANEL=cambia-esta-clave

# 1 = las cámaras nuevas quedan aprobadas solas (pruebas).
# 0 = hay que aprobarlas en el panel (producción).
TAXIFF_AUTO_APROBAR=0

# Confianza mínima del detector (0-1).
TAXIFF_CONF=0.35

# Dominio público del servidor (para HTTPS automático con Caddy en docker-compose).
DOMINIO=taxiff.ejemplo.com
